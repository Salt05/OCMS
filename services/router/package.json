{
  "name": "ocms-router",
  "version": "1.0.0",
  "description": "Universal Central Router & Event Gateway for OCMS",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.copyFileSync('src/registry/routing-rules.json', 'dist/registry/routing-rules.json'); fs.copyFileSync('src/registry/systems-registry.json', 'dist/registry/systems-registry.json'); })\"",
    "test": "echo \"No test specified\" && exit 0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "bullmq": "^6.3.4",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
