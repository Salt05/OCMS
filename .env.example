# === Zalo Sales CRM ===
PORT=3000
NODE_ENV=production
APP_URL=https://zalo.ngay.top

# Security — generate strong random values for production
JWT_SECRET=
ENCRYPTION_KEY=

# Database
DB_USER=crmuser
DB_PASSWORD=
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:password@db:5432/zalocrm

# Storage
UPLOAD_DIR=/var/lib/ocms/files

# AI Order Extraction (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
