# ==============================================================================
# OCMS (Omnichannel Customer Management System) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH ỨNG DỤNG CHÍNH (APP & BACKEND)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3080

# Bảo mật — Hãy tạo chuỗi ngẫu nhiên mạnh cho môi trường Production:
# Sinh JWT_SECRET (32 bytes): openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_32_bytes
# Sinh ENCRYPTION_KEY (16 bytes): openssl rand -hex 16
ENCRYPTION_KEY=change_this_key_16b

# Thư mục lưu trữ file upload, session Zalo và file cache
UPLOAD_DIR=/var/lib/ocms/files

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL
# ------------------------------------------------------------------------------
DB_USER=crmuser
DB_PASSWORD=your_secure_db_password
DB_NAME=zalocrm
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 3. KẾT NỐI ERP ODOO (ĐỒNG BỘ KHÁCH HÀNG, ĐƠN HÀNG, SẢN PHẨM)
# ------------------------------------------------------------------------------
ODOO_URL=https://odooo.your-domain.vn
ODOO_DB=odoo
ODOO_USER=your_odoo_user@email.com
ODOO_API_KEY=your_odoo_api_key

# ------------------------------------------------------------------------------
# 4. KẾT NỐI DIRECTUS HEADLESS CMS (DANH MỤC SẢN PHẨM & MEDIA)
# ------------------------------------------------------------------------------
DIRECTUS_URL=https://directus.your-domain.vn
DIRECTUS_TOKEN=
DIRECTUS_EMAIL=admin@your-domain.vn
DIRECTUS_PASSWORD=your_directus_password
DIRECTUS_PRODUCT_COLLECTION=products

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH AI LLM (CHO CHATBOT AI VÀ TRÍCH XUẤT ĐƠN HÀNG)
# Nhà cung cấp: 'gemini' | 'groq' | 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (Khuyến nghị: Miễn phí, tốc độ cao)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-lite-latest

# Groq Cloud (Tùy chọn dự phòng)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Tùy chọn)
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH TỰ ĐỘNG DỌN DẸP FILE TẠM CHATBOT (VANNA AI DATA CLEANUP)
# ------------------------------------------------------------------------------
# Thời gian lưu trữ tối đa của file CSV truy vấn tạm (giây) - Mặc định: 3 ngày (259200s)
VANNA_DATA_TTL_SECONDS=259200
# Chu kỳ chạy tiến trình ngầm dọn dẹp file quá hạn (giây) - Mặc định: 1 giờ (3600s)
CLEANUP_INTERVAL_SECONDS=3600
