generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Top-level org — every resource is scoped to an org
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams                Team[]
  users                User[]
  zaloAccounts         ZaloAccount[]
  contacts             Contact[]
  conversations        Conversation[]
  appointments         Appointment[]
  activityLogs         ActivityLog[]
  dailyStats           DailyMessageStat[]
  settings             AppSetting[]
  orders               Order[]
  tags                 Tag[]
  tagGroups            TagGroup[]
  quickMessages        QuickMessage[]
  productCaches        ProductCache[]
  customerProfiles     CustomerProfile[]
  orderHistories       OrderHistory[]
  knowledgeBase        KnowledgeBase[]
  chatbotConfigs       ChatbotConfig[]
  syncStates           OdooSyncState[]
  conversationAiStates ConversationAiState[]
  aiAuditLogs          AiAuditLog[]
  promotionPolicies    PromotionPolicy[]
  promotionAuditLogs   PromotionAuditLog[]
  orderAppliedPromotions OrderAppliedPromotion[]

  @@map("organizations")
}

// Team groups within an organization
model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users User[]

  @@map("teams")
}

// CRM user with role-based access
model User {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  teamId       String?  @map("team_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("member") // owner, admin, member
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  odooId       String?  @map("odoo_id")

  org              Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team             Team?               @relation(fields: [teamId], references: [id])
  zaloAccounts     ZaloAccount[]
  zaloAccess       ZaloAccountAccess[]
  assignedContacts Contact[]           @relation("AssignedContacts")
  appointments     Appointment[]
  repliedMessages  Message[]           @relation("RepliedMessages")
  activityLogs     ActivityLog[]
  createdOrders    Order[]             @relation("CreatedOrders")
  quickMessages    QuickMessage[]
  notifications    Notification[]

  @@map("users")
}

// Zalo account linked to a user (one user may own multiple Zalo accounts)
model ZaloAccount {
  id                 String    @id @default(uuid())
  orgId              String    @map("org_id")
  ownerUserId        String    @map("owner_user_id")
  zaloUid            String?   @unique @map("zalo_uid")
  displayName        String?   @map("display_name")
  avatarUrl          String?   @map("avatar_url")
  phone              String?
  status             String    @default("disconnected") // connected, disconnected, qr_pending
  sessionData        Json?     @map("session_data")
  lastConnectedAt    DateTime? @map("last_connected_at")
  aiAutoReply        Boolean   @default(false) @map("ai_auto_reply")
  aiWorkingHoursOnly Boolean   @default(false) @map("ai_working_hours_only")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner         User                @relation(fields: [ownerUserId], references: [id])
  access        ZaloAccountAccess[]
  conversations Conversation[]
  dailyStats    DailyMessageStat[]

  @@map("zalo_accounts")
}

// ACL: which users can access which Zalo accounts
model ZaloAccountAccess {
  id            String   @id @default(uuid())
  zaloAccountId String   @map("zalo_account_id")
  userId        String   @map("user_id")
  permission    String   @default("read") // read, chat, admin
  createdAt     DateTime @default(now()) @map("created_at")

  zaloAccount ZaloAccount @relation(fields: [zaloAccountId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([zaloAccountId, userId])
  @@map("zalo_account_access")
}

// CRM contact record — generic pipeline with status field
model Contact {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  zaloUid          String?   @map("zalo_uid")
  zaloName         String?   @map("zalo_name")
  phone            String?
  email            String?   @map("email")
  fullName         String?   @map("full_name")
  salutation       String?   @map("salutation") // Cách gọi khách hàng (Anh, Chị, Cô, Chú, Bác, Bạn...)
  avatarUrl        String?   @map("avatar_url")
  source           String?   // FB, TT, GT, CN, etc.
  sourceDate       DateTime? @map("source_date")
  firstContactDate DateTime? @map("first_contact_date")
  status           String?   @default("new") // new/contacted/interested/converted/lost
  customerId       String?   @map("customer_id")
  contactType      String    @default("customer") @map("contact_type")
  address          String?   @map("address")
  zone             String?   @map("zone")
  salesperson      String?   @map("salesperson")
  assignedUserId   String?   @map("assigned_user_id")
  notes            String?
  tags             Json      @default("[]")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignedUser  User?          @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  conversations Conversation[]
  appointments  Appointment[]
  orders        Order[]

  @@unique([orgId, zaloUid])
  @@map("contacts")
}

// A chat thread between a Zalo account and a contact (or group)
model Conversation {
  id               String    @id @default(uuid())
  orgId            String    @map("org_id")
  zaloAccountId    String    @map("zalo_account_id")
  contactId        String?   @map("contact_id")
  threadType       String    @default("user") // user, group
  externalThreadId String?   @map("external_thread_id")
  lastMessageAt    DateTime? @map("last_message_at")
  unreadCount      Int       @default(0) @map("unread_count")
  isReplied        Boolean   @default(true) @map("is_replied")
  isPinned         Boolean   @default(false) @map("is_pinned")
  pinnedAt         DateTime? @map("pinned_at")
  aiActive         Boolean   @default(false) @map("ai_active")
  aiPaused         Boolean   @default(false) @map("ai_paused")
  pausedUntil      DateTime? @map("paused_until")
  handoffReason    String?   @map("handoff_reason")
  currentState     String    @default("NEW") @map("current_state")
  contextStartMsgId String?  @map("context_start_msg_id")
  contextEndMsgId   String?  @map("context_end_msg_id")
  contextStartedAt  DateTime? @map("context_started_at")
  contextEndedAt    DateTime? @map("context_ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zaloAccount   ZaloAccount          @relation(fields: [zaloAccountId], references: [id], onDelete: Cascade)
  contact       Contact?             @relation(fields: [contactId], references: [id])
  messages      Message[]
  orders        Order[]
  notifications Notification[]
  aiState       ConversationAiState?
  aiLogs        AiAuditLog[]

  @@unique([zaloAccountId, externalThreadId])
  @@map("conversations")
}

// Individual message within a conversation
model Message {
  id              String    @id @default(uuid())
  conversationId  String    @map("conversation_id")
  zaloMsgId       String?   @map("zalo_msg_id")
  senderType      String    @map("sender_type") // self, contact
  senderUid       String?   @map("sender_uid")
  senderName      String?   @map("sender_name")
  content         String?
  contentType     String    @default("text") @map("content_type") // text, image, file, sticker, voice, video, link
  attachments     Json      @default("[]")
  reactions       Json      @default("[]")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  sentAt          DateTime  @map("sent_at")
  repliedByUserId String?   @map("replied_by_user_id")
  isNote          Boolean   @default(false) @map("is_note")
  isAi            Boolean   @default(false) @map("is_ai")
  replyToId       String?   @map("reply_to_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  repliedBy    User?        @relation("RepliedMessages", fields: [repliedByUserId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@map("messages")
}

// Appointment scheduled for a contact
model Appointment {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String   @map("contact_id")
  assignedUserId  String?  @map("assigned_user_id")
  appointmentDate DateTime @map("appointment_date")
  appointmentTime String?  @map("appointment_time")
  type            String?
  status          String   @default("scheduled") // scheduled, completed, cancelled, no_show
  notes           String?
  reminderSent    Boolean  @default(false) @map("reminder_sent")
  createdAt       DateTime @default(now()) @map("created_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])

  @@map("appointments")
}

// Audit trail for user actions
model ActivityLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

// Daily messaging statistics per user per Zalo account
model DailyMessageStat {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  userId            String   @map("user_id")
  zaloAccountId     String   @map("zalo_account_id")
  statDate          DateTime @map("stat_date") @db.Date
  messagesSent      Int      @default(0) @map("messages_sent")
  messagesReceived  Int      @default(0) @map("messages_received")
  messagesUnread    Int      @default(0) @map("messages_unread")
  messagesUnreplied Int      @default(0) @map("messages_unreplied")
  avgResponseTime   Int?     @map("avg_response_time_seconds")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zaloAccount ZaloAccount  @relation(fields: [zaloAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, zaloAccountId, statDate])
  @@map("daily_message_stats")
}

// Encrypted or plain key-value settings per org
model AppSetting {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  settingKey     String   @map("setting_key")
  valuePlain     String?  @map("value_plain")
  valueEncrypted Bytes?   @map("value_encrypted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, settingKey])
  @@map("app_settings")
}

// Sales order linked to a contact (and optionally a conversation)
model Order {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  contactId       String   @map("contact_id")
  createdByUserId String   @map("created_by_user_id")
  conversationId  String?  @map("conversation_id")
  orderCode       String   @map("order_code")
  totalAmount     Float    @map("total_amount")
  discountAmount  Float    @default(0) @map("discount_amount")
  status          String   @default("new") // new, confirmed, paid, shipped, completed, cancelled
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact           Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation("CreatedOrders", fields: [createdByUserId], references: [id])
  conversation      Conversation?           @relation(fields: [conversationId], references: [id])
  appliedPromotions OrderAppliedPromotion[]

  @@map("orders")
}

// Organization-scoped tags with custom colors
model Tag {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("tags")
}

// Organization-scoped tag groups for quick filtering
model TagGroup {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  color     String?
  tags      Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("tag_groups")
}

// Organization-scoped canned responses/quick templates
model QuickMessage {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  userId      String?  @map("user_id")
  shortcut    String
  title       String
  content     String   @db.Text
  attachments Json     @default("[]")
  isShared    Boolean  @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orgId, shortcut])
  @@map("quick_messages")
}

model Notification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String   // "mention", "reply", etc.
  title          String
  detail         String
  isRead         Boolean  @default(false) @map("is_read")
  conversationId String?  @map("conversation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// Track incremental sync state per Odoo model
model OdooSyncState {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  modelName     String   @map("model_name") // e.g. 'res.partner', 'sale.order'
  lastSyncedAt  DateTime @map("last_synced_at")
  lastWriteDate String?  @map("last_write_date") // Odoo write_date string
  recordCount   Int      @default(0) @map("record_count")
  status        String   @default("idle") // idle, syncing, error
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, modelName])
  @@map("odoo_sync_states")
}

// Structured product catalog cached from Odoo + Directus
model ProductCache {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  odooId         Int      @map("odoo_id")
  sku            String?  // default_code from Odoo
  name           String
  displayName    String?  @map("display_name")
  listPrice      Float    @default(0) @map("list_price")
  wholesalePrice Float    @default(0) @map("wholesale_price")
  retailPrice    Float    @default(0) @map("retail_price")
  uomName        String?  @map("uom_name")
  weight         String?
  specification  String?
  imageUrl       String?  @map("image_url")
  description    String?  @db.Text
  ingredients    String?  @db.Text
  target         String?  // target audience (e.g. "Chó con 3-6 tháng")
  preservation   String?  // storage instructions
  brand          String?  // brand e.g. Lapati, Dexinbone, INU
  category       String?  // category e.g. Xương gặm, Bánh thưởng
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, odooId])
  @@map("product_cache")
}

// Customer profile synced from Odoo res.partner
model CustomerProfile {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  odooPartnerId   Int       @map("odoo_partner_id")
  name            String
  phone           String?
  mobile          String?
  email           String?
  street          String?
  city            String?
  zone            String?
  fullAddress     String?   @map("full_address")
  vat             String?   // Tax ID
  salesperson     String?
  salespersonId   Int?      @map("salesperson_id") // Odoo user_id
  paymentTermName String?   @map("payment_term_name")
  totalOrders     Int       @default(0) @map("total_orders")
  totalRevenue    Float     @default(0) @map("total_revenue")
  lastOrderDate   DateTime? @map("last_order_date")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderHistory OrderHistory[]

  @@unique([orgId, odooPartnerId])
  @@map("customer_profiles")
}

// Order history synced from Odoo sale.order
model OrderHistory {
  id                 String   @id @default(uuid())
  orgId              String   @map("org_id")
  odooOrderId        Int      @map("odoo_order_id")
  orderCode          String   @map("order_code") // e.g. S02300
  customerProfileId  String?  @map("customer_profile_id")
  odooPartnerId      Int      @map("odoo_partner_id")
  partnerName        String?  @map("partner_name")
  dateOrder          DateTime @map("date_order")
  state              String   // draft, sale, done, cancel
  amountUntaxed      Float    @default(0) @map("amount_untaxed")
  amountTax          Float    @default(0) @map("amount_tax")
  amountTotal        Float    @default(0) @map("amount_total")
  amountUndiscounted Float    @default(0) @map("amount_undiscounted")
  discountAmount     Float    @default(0) @map("discount_amount")
  margin             Float    @default(0)
  marginPercent      Float    @default(0) @map("margin_percent")
  invoiceStatus      String?  @map("invoice_status")
  deliveryStatus     String?  @map("delivery_status") // pending, started, full
  warehouseName      String?  @map("warehouse_name") // e.g. TPHCM
  pricelistName      String?  @map("pricelist_name")
  salesperson        String?
  salespersonId      Int?     @map("salesperson_id")
  expectedDate       DateTime? @map("expected_date")
  validityDate       DateTime? @map("validity_date")
  activitySummary    String?  @map("activity_summary")
  pickingIds         Json?    @map("picking_ids")
  note               String?  @db.Text
  pdfSentAt          DateTime? @map("pdf_sent_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  org             Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile?        @relation(fields: [customerProfileId], references: [id])
  lines           OrderLineHistory[]
  appliedPromotions OrderAppliedPromotion[]

  @@unique([orgId, odooOrderId])
  @@map("order_histories")
}

// Order line details synced from Odoo sale.order.line
model OrderLineHistory {
  id             String @id @default(uuid())
  orderHistoryId String @map("order_history_id")
  odooLineId     Int    @map("odoo_line_id")
  productName    String @map("product_name")
  productSku     String? @map("product_sku")
  odooProductId  Int?   @map("odoo_product_id")
  uomName        String? @map("uom_name")
  quantity       Float  @default(0)
  priceUnit      Float  @default(0) @map("price_unit")
  discount       Float  @default(0)
  priceSubtotal  Float  @default(0) @map("price_subtotal")
  priceTotal     Float  @default(0) @map("price_total")
  qtyDelivered   Float  @default(0) @map("qty_delivered")
  qtyInvoiced    Float  @default(0) @map("qty_invoiced")

  orderHistory OrderHistory @relation(fields: [orderHistoryId], references: [id], onDelete: Cascade)

  @@unique([orderHistoryId, odooLineId])
  @@map("order_line_histories")
}

// Knowledge base items for chatbot (FAQ, policies, product guides)
model KnowledgeBase {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  category  String   // faq, policy, product_guide, script
  title     String
  content   String   @db.Text
  keywords  String?  @db.Text // comma-separated keywords for search
  isPublic  Boolean  @default(true) @map("is_public") // visible to customer bot?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("knowledge_base")
}

// Chatbot configuration per organization
model ChatbotConfig {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  provider     String   @default("google") // google, openai, anthropic
  apiKey       String   @map("api_key")
  modelName    String   @default("gemini-2.0-flash") @map("model_name")
  systemPrompt String?  @map("system_prompt") @db.Text
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(2048) @map("max_tokens")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("chatbot_configs")
}

// Conversation AI state and 3-tier memory tracking
model ConversationAiState {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  conversationId  String   @unique @map("conversation_id")
  petInfo         Json     @default("{}") @map("pet_info")
  customerSegment String   @default("retail") @map("customer_segment")
  draftOrder      Json     @default("{}") @map("draft_order")
  contextSummary  String?  @db.Text @map("context_summary")
  failedAttempts  Int      @default(0) @map("failed_attempts")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_ai_states")
}

// Audit trail for AI inference, tool calls and handoff tracking
model AiAuditLog {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  conversationId String   @map("conversation_id")
  userMessage    String   @db.Text @map("user_message")
  intentDetected String   @map("intent_detected")
  toolCalls      Json     @default("[]") @map("tool_calls")
  aiResponse     String   @db.Text @map("ai_response")
  latencyMs      Int      @map("latency_ms")
  modelUsed      String   @map("model_used")
  isHandoff      Boolean  @default(false) @map("is_handoff")
  createdAt      DateTime @default(now()) @map("created_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_audit_logs")
}

// ── Promotion & Pricing Data-Driven Schema ────────────────────────────────────

// Data-driven Promotion & Discount Policy definition
model PromotionPolicy {
  id              String    @id @default(uuid())
  orgId           String    @map("org_id")
  code            String    // unique code within org e.g. LA_PET_BASIC_22, LA_PET_CHEW_TIER
  name            String
  description     String?   @db.Text
  type            String    // BASIC_DISCOUNT, TIER_DISCOUNT, SPECIAL_PRICE, BUY_X_GET_Y, COMBO, PERCENT_DISCOUNT, FIXED_AMOUNT, SALES_REWARD_QUARTER, SALES_REWARD_YEAR, CUSTOM_TEXT
  targetScope     String    @default("ALL_PRODUCTS") @map("target_scope") // ALL_PRODUCTS, CATEGORY, BRAND, SPECIFIC_SKUS, ORDER_TOTAL
  priority        Int       @default(10)
  isStackable     Boolean   @default(true) @map("is_stackable")
  isActive        Boolean   @default(true) @map("is_active")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  version         Int       @default(1)
  parentPolicyId  String?   @map("parent_policy_id") // lineage to previous version if cloned/superseded
  conditions      Json      @default("{}") // minOrderValue, minQuantity, customerTypes, applicableCategories, applicableBrands, applicableSkus, requiredAllSkus, rewardRequirements
  actions         Json      @default("{}") // actionType, discountPercent, discountAmount, specialUnitPrice, buyQuantity, getQuantity, giftType, giftSku, tiers, rewardTiers
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  org               Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditLogs         PromotionAuditLog[]
  appliedPromotions OrderAppliedPromotion[]

  @@unique([orgId, code, version])
  @@index([orgId, isActive])
  @@index([orgId, code])
  @@map("promotion_policies")
}

// Audit log for Promotion changes & version transitions
model PromotionAuditLog {
  id              String   @id @default(uuid())
  orgId           String   @map("org_id")
  promotionId     String   @map("promotion_id")
  version         Int
  changedByUserId String?  @map("changed_by_user_id")
  changeType      String   @map("change_type") // CREATE, UPDATE, ACTIVATE, DEACTIVATE, NEW_VERSION
  snapshotBefore  Json?    @map("snapshot_before")
  snapshotAfter   Json     @map("snapshot_after")
  diff            Json?    @default("{}")
  comment         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  promotion PromotionPolicy @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([createdAt])
  @@map("promotion_audit_logs")
}

// Immutable snapshot of promotion applied to an order
model OrderAppliedPromotion {
  id                  String   @id @default(uuid())
  orgId               String   @map("org_id")
  orderHistoryId      String?  @map("order_history_id")
  orderId             String?  @map("order_id")
  promotionId         String   @map("promotion_id")
  promotionCode       String   @map("promotion_code")
  promotionName       String   @map("promotion_name")
  policyVersion       Int      @default(1) @map("policy_version")
  discountAmount      Float    @default(0) @map("discount_amount")
  freeItems           Json     @default("[]") @map("free_items")
  appliedRuleSnapshot Json     @default("{}") @map("applied_rule_snapshot")
  explanation         String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  org          Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderHistory OrderHistory?    @relation(fields: [orderHistoryId], references: [id], onDelete: Cascade)
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion    PromotionPolicy? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderHistoryId])
  @@index([orderId])
  @@index([promotionCode])
  @@map("order_applied_promotions")
}
